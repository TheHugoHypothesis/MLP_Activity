{
    "experiment_id": "exp_001",
    "use_cross_validation": false,
    "cross_validation_folds": 3,
    "hold_out_p_train": 0.7,
    "hold_out_p_validation": 0.15,
    "num_epochs": 400,
    "learning_rate": 0.001,
    "patience": 10,
