        "momentum": 0.9,
        "l2_decay": 0.0001
    },
    "layers": [
        {
            "n_neurons": 64,
            "activation": "relu",
            "initializer": "he"
        },
        {
            "n_neurons": 26,
            "activation": "linear",
            "initializer": "xavier"
        }
    ],
    "random_seed": 3,
    "x_path": "data/raw/X.npy",
    "y_path": "data/raw/Y_classe.npy"
